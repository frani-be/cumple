---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmbroideryPattern from '../components/EmbroideryPattern.astro';

const EVENT_DATE_ISO = '2026-11-27T20:00:00-03:00';

// Banderines de la guirnalda del hero: arco suave sobre el ancho del viewport
const flagColors = ['#e8492c', '#e8a02c', '#4e8a57', '#f0b28e', '#c2351f'];
const flags = Array.from({ length: 26 }, (_, i) => {
  const t = i / 25;
  return {
    x: 1200 * t,
    y: 8 + 144 * t - 144 * t * t,
    color: flagColors[i % flagColors.length],
  };
});

// Confeti flotante del hero
const confetti = [
  { top: '26%', left: '12%', bg: '#e8a02c', rot: '18deg', delay: '-1s', round: false },
  { top: '58%', left: '7%', bg: '#4e8a57', rot: '-24deg', delay: '-2.4s', round: true },
  { top: '16%', left: '44%', bg: '#e8492c', rot: '30deg', delay: '-3.5s', round: false },
  { top: '78%', left: '34%', bg: '#f0b28e', rot: '-12deg', delay: '-4.2s', round: true },
  { top: '10%', left: '72%', bg: '#4e8a57', rot: '42deg', delay: '-0.8s', round: false },
  { top: '70%', left: '88%', bg: '#e8a02c', rot: '-30deg', delay: '-2s', round: true },
  { top: '38%', left: '94%', bg: '#e8492c', rot: '15deg', delay: '-5s', round: false },
  { top: '86%', left: '58%', bg: '#c2351f', rot: '-40deg', delay: '-3s', round: true },
];

const donaciones = [
  { monto: '$5.000', desc: 'Una porción de tallarines simbólica para Alonso.', href: 'https://mpago.la/2rPVwuB' },
  { monto: '$15.000', desc: 'La tallarinata completa, con bingo incluido.', href: 'https://mpago.la/1Zim2jM', destacada: true },
  { monto: '$30.000', desc: 'Modo generosidad: Alonso te lo agradece doble.', href: 'https://mpago.la/2z3PFd5' },
];

const beneficiosMP = [
  {
    titulo: 'Todos los medios de pago',
    desc: 'Tarjeta de crédito, débito, prepago o el saldo de tu cuenta de Mercado Pago.',
    icon: 'M3 8.5A2.5 2.5 0 0 1 5.5 6h13A2.5 2.5 0 0 1 21 8.5v7a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 15.5v-7zM3 10h18M7 14.5h4',
  },
  {
    titulo: 'Puedes pagar en cuotas',
    desc: 'Con tarjeta de crédito eliges el número de cuotas que te acomode.',
    icon: 'M8 2v4M16 2v4M3 9h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM9 14l2 2 4-4',
  },
  {
    titulo: 'Sin cuenta, sin drama',
    desc: 'No necesitas estar registrado en Mercado Pago: pagas como invitado con tus datos.',
    icon: 'M13 3L4 14h6l-1 7 9-11h-6l1-7z',
  },
  {
    titulo: 'Pago protegido',
    desc: 'Tus datos viajan cifrados y tu plata llega directo. Recibes comprobante al instante.',
    icon: 'M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4zM9 12l2 2 4-4',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Cumple Frani: Tallarinata + Bingo a beneficio de Alonso',
  description: 'Celebración de cumpleaños con tallarinata y bingo. En vez de regalos, donaciones por Mercado Pago para Alonso, que perdió la inversión de su tienda en Pichilemu tras un robo.',
  startDate: EVENT_DATE_ISO,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Por confirmar',
    address: { '@type': 'PostalAddress', addressCountry: 'CL' },
  },
  organizer: {
    '@type': 'Person',
    name: 'Francisca Beatriz Medina Concha',
    url: 'https://frani.be/',
  },
};
---

<BaseLayout
  title="Tallarinata + Bingo | Cumple Frani a beneficio de Alonso"
  description="Este año mi cumpleaños tiene causa: tallarines, bingo y donaciones por Mercado Pago para Alonso, que perdió la inversión de su tienda en Pichilemu. Viernes 27 de noviembre."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero -->
  <header class="hero-home pt-40 pb-24 text-center lg:text-left w-screen relative overflow-hidden isolate">
    <svg class="banderines" viewBox="0 0 1200 95" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 8 Q600 80 1200 8" fill="none" stroke="#c2351f" stroke-width="3" opacity="0.45" />
      {flags.map(f => (
        <path
          d={`M${(f.x - 11).toFixed(1)} ${(f.y + 2).toFixed(1)} L${(f.x + 11).toFixed(1)} ${(f.y + 2).toFixed(1)} L${f.x.toFixed(1)} ${(f.y + 30).toFixed(1)} Z`}
          fill={f.color}
        />
      ))}
    </svg>
    {confetti.map((c, i) => (
      <span
        class:list={['confetti-bit', { 'confetti-bit--round': c.round, 'hidden md:block': i > 3 }]}
        style={`top:${c.top}; left:${c.left}; background:${c.bg}; transform:rotate(${c.rot}); animation-delay:${c.delay}`}
      />
    ))}
    <span class="bingo-ball hidden md:flex" style="top:18%; left:5%; animation-delay:-1.5s">B-27</span>
    <span class="bingo-ball bingo-ball--sm bingo-ball--mustard hidden md:flex" style="top:64%; left:3%; animation-delay:-3s">N-11</span>
    <span class="bingo-ball bingo-ball--basil hidden lg:flex" style="top:12%; right:4%; animation-delay:-4.5s">G-52</span>
    <div class="container-wide flex flex-col lg:flex-row gap-12 items-center relative z-[1]">
      <div class="w-full lg:w-3/5">
        <p class="hero-eyebrow">Viernes 27 de noviembre · 20:00</p>
        <h1 class="mt-6 text-custom-black leading-[0.95]">
          <span class="block text-[1.05em] lg:text-[1.2em] font-medium">Este cumple, nada de regalos:</span>
          <span class="text-gradient block text-[2.4em] lg:text-[3em]">Tallarinata + Bingo</span>
        </h1>
        <p class="text-[1.15em] mt-5 text-custom-dark-gray max-w-[34rem] mx-auto lg:mx-0">
          Sí, hay fiesta: pastas y cartones el 27 a las 20:00. Pero lo único que te voy a pedir
          es una donación para mi amigo <strong class="font-semibold text-custom-black">Alonso</strong>.
          Abajo te cuento por qué.
        </p>
        <div class="countdown mt-7" id="countdown" role="timer" aria-label="Cuenta regresiva para la tallarinata">
          <div class="count-unit"><span class="count-num" data-cd="d">--</span><span class="count-lbl">días</span></div>
          <span class="count-sep">:</span>
          <div class="count-unit"><span class="count-num" data-cd="h">--</span><span class="count-lbl">hrs</span></div>
          <span class="count-sep">:</span>
          <div class="count-unit"><span class="count-num" data-cd="m">--</span><span class="count-lbl">min</span></div>
          <span class="count-sep">:</span>
          <div class="count-unit"><span class="count-num" data-cd="s">--</span><span class="count-lbl">seg</span></div>
        </div>
        <div class="flex flex-wrap gap-4 mt-8 justify-center lg:justify-start">
          <a href="#donar" class="btn btn-primary">Quiero donar</a>
          <a href="#causa" class="btn btn-secondary">La historia</a>
        </div>
      </div>

      <div class="relative flex flex-col gap-6 items-center w-full lg:w-2/5">
        <EmbroideryPattern class="absolute -top-8 right-0 lg:-right-8 rotate-6" cells={5} />
        <figure class="hero-photo-wrap sticker-tilt">
          <img
            src="/images/tallarinata.svg"
            alt="Ilustración de un plato de tallarines junto a un cartón y bolillas de bingo"
            id="main-image"
            class="illus-frame"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </header>

  <!-- Donaciones -->
  <section class="section-block donar-band" id="donar">
    <div class="container-mid">
      <div class="section-title-wrapper">
        <span class="section-tag">// lo único que te pido</span>
        <h2 class="section-title-front">Dona para Alonso</h2>
        <p class="section-title-subtitle">
          Cinco, quince o treinta lucas, o lo que te nazca. La entrada a la tallarinata
          es liberada: tu donación es el regalo, y va directo a su tienda.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {donaciones.map(d => (
          <a
            href={d.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['service-card p-6 text-center', { 'donacion-card--destacada': d.destacada }]}
          >
            <span class="service-name">{d.destacada ? 'La más elegida' : 'Donación'}</span>
            <span class="block text-[2.4em] font-bold leading-none" style="font-family:var(--font-family-titles)">{d.monto}</span>
            <p class="text-sm text-custom-dark-gray mt-3">{d.desc}</p>
            <span class="btn btn-primary mt-5">Donar {d.monto}</span>
          </a>
        ))}
      </div>
      <div class="mt-6 text-center">
        <a
          href="https://link.mercadopago.cl/cumplefranibe"
          target="_blank"
          rel="noopener noreferrer"
          class="service-card p-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-left"
        >
          <div>
            <span class="service-name">Otro monto</span>
            <h3 class="text-lg font-semibold">¿Quieres donar otra cantidad?</h3>
            <p class="text-sm text-custom-dark-gray mt-1">
              link.mercadopago.cl/cumplefranibe
            </p>
          </div>
          <span class="btn btn-secondary flex-shrink-0">Donar monto libre</span>
        </a>
      </div>
      <div class="service-card p-6 mt-6">
        <div class="flex items-start gap-4">
          <span class="icon-tile icon-tile-lg" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4zM9 12l2 2 4-4" />
            </svg>
          </span>
          <div>
            <span class="service-name">Transparencia</span>
            <h3 class="text-lg font-semibold">Esta cuenta es solo para esto</h3>
            <p class="text-sm text-custom-dark-gray mt-1">
              El link de Mercado Pago <strong class="font-semibold text-custom-black">cumplefranibe</strong>
              lo creé exclusivamente para esta colecta: nada de lo que entre se mezcla con mi plata.
              Cuando cierre la recaudación, publico en esta misma página el total juntado
              y el 100% se lo entrego a Alonso.
            </p>
          </div>
        </div>
      </div>
      <p class="text-center text-sm text-custom-dark-gray mt-6 flex items-center justify-center gap-2 flex-wrap">
        Pagos procesados por
        <span class="mp-badge mp-badge--sm"><img src="/images/mp-handshake.svg" alt="Mercado Pago" /></span>.
        Cada peso va directo a la recuperación de la tienda de Alonso.
      </p>
    </div>
  </section>

  <!-- La historia -->
  <section class="section-block-sm mantel-bg" id="causa">
    <div class="container-narrow">
      <div class="section-title-wrapper">
        <span class="section-tag section-tag--basil">// la historia</span>
        <h2 class="section-title-front">Alonso está partiendo de cero</h2>
      </div>
      <article class="service-card p-8 lg:p-10">
        <p class="text-custom-dark-gray leading-relaxed">
          Alonso se fue a Pichilemu e invirtió sus ahorros en una tienda.
          Un robo se llevó esa inversión completa, y hoy está partiendo de cero.
        </p>
        <p class="text-custom-dark-gray leading-relaxed mt-4">
          Podía quedarme solo con la lata, o hacer lo que sé hacer:
          juntar gente querida alrededor de una mesa. Así que este cumple
          tiene una sola condición: <strong class="font-semibold text-custom-black">nada de regalos,
          todo para Alonso</strong>.
        </p>
        <p class="text-custom-dark-gray leading-relaxed mt-4">
          Si puedes venir, maravilloso: hay tallarines y bingo. Si no puedes,
          tu donación corre igual de lejos.
        </p>
        <p class="mt-7"><span class="firma">un abrazo, Frani</span></p>
      </article>
    </div>
  </section>

  <!-- La fiesta -->
  <section class="section-block-sm" id="detalles">
    <div class="container-mid">
      <div class="section-title-wrapper">
        <span class="section-tag section-tag--mustard">// la fiesta</span>
        <h2 class="section-title-front">Tallarines, bingo y sobremesa</h2>
        <p class="section-title-subtitle">
          La logística es simple. Lo difícil será ganarme en el bingo.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="service-card p-6">
          <span class="service-name">Cuándo</span>
          <h3 class="text-lg font-semibold">Viernes 27 de noviembre</h3>
          <p class="text-sm text-custom-dark-gray mt-2">
            Desde las 20:00: primero se sirven las pastas, después salen los cartones.
          </p>
          <span class="tag-mono tag-mono--basil mt-4">Entrada liberada</span>
        </article>
        <article class="service-card p-6">
          <span class="service-name">Dónde</span>
          <h3 class="text-lg font-semibold">Lugar por confirmar</h3>
          <p class="text-sm text-custom-dark-gray mt-2">
            Todavía estoy cerrando el lugar. Te aviso apenas lo tenga, por acá y por WhatsApp.
          </p>
          <span class="tag-mono mt-4">Dirección por confirmar</span>
        </article>
        <article class="service-card p-6">
          <span class="service-name">Qué hay</span>
          <h3 class="text-lg font-semibold">Tallarinata + bingo</h3>
          <p class="text-sm text-custom-dark-gray mt-2">
            Tallarinata casera, rondas de bingo con premios y sobremesa larga.
          </p>
          <span class="tag-mono tag-mono--accent mt-4">Trae buen apetito</span>
        </article>
      </div>
    </div>
  </section>

  <!-- Cómo pagar -->
  <section class="section-block-sm">
    <div class="container-mid">
      <div class="section-title-wrapper">
        <span class="section-tag">// sin excusas</span>
        <h2 class="section-title-front">Donar toma dos minutos</h2>
        <p class="section-title-subtitle">
          Uso Mercado Pago porque acepta casi todo y no necesitas cuenta para pagar.
        </p>
        <p class="mt-5 flex justify-center">
          <span class="mp-badge"><img src="/images/mp-handshake.svg" alt="Mercado Pago" /></span>
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {beneficiosMP.map(b => (
          <div class="flex items-start gap-4">
            <span class="icon-tile icon-tile-lg" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={b.icon} />
              </svg>
            </span>
            <div>
              <h3 class="font-semibold">{b.titulo}</h3>
              <p class="text-sm text-custom-dark-gray mt-1">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cierre / RSVP -->
  <section class="page-hero text-center">
    <div class="container-narrow py-16 lg:py-20">
      <span class="section-tag section-tag--dark">// nos vemos</span>
      <h2 class="section-title-front section-title-front--dark">El 27 nos vemos</h2>
      <p class="section-title-subtitle section-title-subtitle--dark">
        Confírmame por WhatsApp así calculo cuántos tallarines cocinar
        (y cuántos cartones imprimir). Si no puedes venir, la donación corre igual.
      </p>
      <div class="flex flex-wrap gap-4 mt-8 justify-center">
        <a
          href="https://wa.me/56944678724?text=%C2%A1Voy%20a%20la%20tallarinata%20%2B%20bingo%21"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-white"
        >Confirmar por WhatsApp</a>
        <a href="#donar" class="btn btn-outline-white">Ir a donar</a>
      </div>
    </div>
  </section>

  <script>
    // Cuenta regresiva al evento: días : hrs : min : seg
    const target = new Date('2026-11-27T20:00:00-03:00').getTime();
    const el = document.getElementById('countdown');
    const set = (k: string, v: string) => {
      const n = el?.querySelector(`[data-cd="${k}"]`);
      if (n) n.textContent = v;
    };
    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      const days = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      set('d', String(days).padStart(2, '0'));
      set('h', String(h).padStart(2, '0'));
      set('m', String(m).padStart(2, '0'));
      set('s', String(s).padStart(2, '0'));
    };
    tick();
    setInterval(tick, 1000);
  </script>
</BaseLayout>
