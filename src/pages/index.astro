---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmbroideryPattern from '../components/EmbroideryPattern.astro';

const EVENT_DATE_ISO = '2026-11-27T20:00:00-03:00';

// Confeti flotante del hero
const confetti = [
  { top: '26%', left: '12%', bg: '#e8a02c', rot: '18deg', delay: '-1s', round: false },
  { top: '58%', left: '7%', bg: '#4e8a57', rot: '-24deg', delay: '-2.4s', round: true },
  { top: '16%', left: '44%', bg: '#e8492c', rot: '30deg', delay: '-3.5s', round: false },
  { top: '78%', left: '34%', bg: '#f0b28e', rot: '-12deg', delay: '-4.2s', round: true },
  { top: '10%', left: '72%', bg: '#4e8a57', rot: '42deg', delay: '-0.8s', round: false },
  { top: '70%', left: '88%', bg: '#e8a02c', rot: '-30deg', delay: '-2s', round: true },
  { top: '38%', left: '94%', bg: '#e8492c', rot: '15deg', delay: '-5s', round: false },
  { top: '86%', left: '58%', bg: '#c2351f', rot: '-40deg', delay: '-3s', round: true },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Cumple Frani: Tallarinata + Bingo',
  description: 'Celebración de cumpleaños con tallarinata vegana, bingo y lista de regalos con reserva anónima.',
  startDate: EVENT_DATE_ISO,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Por confirmar',
    address: { '@type': 'PostalAddress', addressCountry: 'CL' },
  },
  organizer: {
    '@type': 'Person',
    name: 'Francisca Beatriz Medina Concha',
    url: 'https://frani.be/',
  },
};
---

<BaseLayout
  title="Tallarinata + Bingo | Cumple Frani"
  description="Mi cumpleaños se celebra con tallarinata vegana y bingo. Viernes 27 de noviembre a las 20:00: confirma tu asistencia y mira la lista de regalos."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero -->
  <header class="hero-home pt-40 pb-24 text-center lg:text-left w-screen relative overflow-hidden isolate">
    <img src="/images/guirnalda.svg" class="banderines" alt="" aria-hidden="true" />
    {confetti.map((c, i) => (
      <span
        class:list={['confetti-bit', { 'confetti-bit--round': c.round, 'hidden md:block': i > 3 }]}
        style={`top:${c.top}; left:${c.left}; background:${c.bg}; transform:rotate(${c.rot}); animation-delay:${c.delay}`}
      />
    ))}
    <span class="bingo-ball hidden md:flex" style="top:34%; left:4%; animation-delay:-1.5s">B-27</span>
    <span class="bingo-ball bingo-ball--sm bingo-ball--mustard hidden md:flex" style="top:66%; left:2%; animation-delay:-3s">N-11</span>
    <span class="bingo-ball bingo-ball--basil hidden lg:flex" style="top:28%; right:3%; animation-delay:-4.5s">G-52</span>
    <div class="container-wide flex flex-col lg:flex-row gap-12 items-center relative z-[1]">
      <div class="w-full lg:w-3/5">
        <p class="hero-eyebrow">Viernes 27 de noviembre · 20:00</p>
        <h1 class="mt-6 text-custom-black leading-[0.95]">
          <span class="block text-[1.05em] lg:text-[1.2em] font-medium">Este cumple lo celebramos con</span>
          <span class="text-gradient block text-[2.4em] lg:text-[3em] pb-[0.18em] -mb-[0.18em]">Tallarinata + Bingo</span>
        </h1>
        <p class="text-[1.15em] mt-5 text-custom-dark-gray max-w-[34rem] mx-auto lg:mx-0">
          Hay fiesta: tallarinata vegana, cartones de bingo y sobremesa larga el 27 a las 20:00.
          Confirma tu asistencia para calcular tallarines y cartones, y si quieres regalarme algo,
          abajo está <strong class="font-semibold text-custom-black">la lista de regalos</strong>.
        </p>
        <div class="countdown mt-7" id="countdown" role="timer" aria-label="Cuenta regresiva para la tallarinata">
          <div class="count-unit"><span class="count-num" data-cd="d">--</span><span class="count-lbl">días</span></div>
          <span class="count-sep">:</span>
          <div class="count-unit"><span class="count-num" data-cd="h">--</span><span class="count-lbl">hrs</span></div>
          <span class="count-sep">:</span>
          <div class="count-unit"><span class="count-num" data-cd="m">--</span><span class="count-lbl">min</span></div>
          <span class="count-sep">:</span>
          <div class="count-unit"><span class="count-num" data-cd="s">--</span><span class="count-lbl">seg</span></div>
        </div>
        <div class="flex flex-wrap gap-4 mt-8 justify-center lg:justify-start">
          <a href="#confirmar" class="btn btn-primary">Confirmar asistencia</a>
          <a href="#regalos" class="btn btn-secondary">Ver regalos</a>
        </div>
      </div>

      <div class="relative flex flex-col gap-6 items-center w-full lg:w-2/5">
        <EmbroideryPattern class="absolute -top-8 right-0 lg:-right-8 rotate-6" cells={5} />
        <figure class="hero-photo-wrap sticker-tilt">
          <img
            src="/images/cumple-hero.webp"
            alt="Ilustración de cumpleaños: cartón de bingo, plato de tallarines, globos y torta con velas"
            width="1254"
            height="1254"
            id="main-image"
            class="illus-frame"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </header>

  <!-- Lista de regalos -->
  <section class="section-block regalos-band" id="regalos">
    <div class="container-mid">
      <div class="section-title-wrapper">
        <img src="/images/regalo-lazo.png" alt="" aria-hidden="true" class="regalo-deco" />
        <span class="section-tag">// opcional pero se agradece</span>
        <h2 class="section-title-front">La lista de regalos</h2>
        <p class="section-title-subtitle">
          Si quieres regalarme algo, aquí hay ideas con precio referencial y link de compra.
          Marca el tuyo con "Yo lo regalo": se bloquea para que no salga repetido
          y nadie sabrá que fuiste tú (ni yo). Si te arrepientes, lo liberas
          desde el mismo navegador.
        </p>
      </div>
      <div class="service-card tabla-regalos-wrap">
        <div class="tabla-scroll">
          <table class="tabla-regalos">
            <thead>
              <tr>
                <th scope="col">Regalo</th>
                <th scope="col">Precio aprox.</th>
                <th scope="col">Dónde</th>
                <th scope="col">Estado</th>
              </tr>
            </thead>
            <tbody id="regalos-grid">
              <tr><td colspan="4"><p class="regalos-msg">// cargando la lista...</p></td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <p class="form-status" id="regalos-status" role="status" aria-live="polite"></p>
    </div>
  </section>

  <!-- La fiesta -->
  <section class="section-block-sm" id="detalles">
    <div class="container-mid">
      <div class="section-title-wrapper">
        <span class="section-tag section-tag--mustard">// la fiesta</span>
        <h2 class="section-title-front">Tallarines, bingo y sobremesa</h2>
        <p class="section-title-subtitle">
          La logística es simple. Lo difícil será ganarme en el bingo.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="service-card p-6">
          <span class="service-name">Cuándo</span>
          <h3 class="text-lg font-semibold">Viernes 27 de noviembre</h3>
          <p class="text-sm text-custom-dark-gray mt-2">
            Desde las 20:00: primero se sirven las pastas veganas, después salen los cartones.
          </p>
          <span class="tag-mono tag-mono--basil mt-4">Entrada liberada</span>
        </article>
        <article class="service-card p-6">
          <span class="service-name">Dónde</span>
          <h3 class="text-lg font-semibold">Lugar por confirmar</h3>
          <p class="text-sm text-custom-dark-gray mt-2">
            Todavía estoy cerrando el lugar. Te aviso apenas lo tenga, por acá y por WhatsApp.
          </p>
          <span class="tag-mono mt-4">Dirección por confirmar</span>
        </article>
        <article class="service-card p-6">
          <span class="service-name">Qué hay</span>
          <div class="flex items-center gap-3">
            <img src="/images/vegan.svg" alt="Sello vegano" class="w-10 h-10" loading="lazy" decoding="async" />
            <h3 class="text-lg font-semibold">Tallarinata vegana + bingo</h3>
          </div>
          <p class="text-sm text-custom-dark-gray mt-2">
            Tallarinata casera 100% vegana, rondas de bingo con premios y sobremesa larga.
          </p>
          <span class="tag-mono tag-mono--basil mt-4">Menú 100% vegano</span>
        </article>
      </div>
    </div>
  </section>

  <!-- Cierre / RSVP -->
  <section class="page-hero text-center" id="confirmar">
    <div class="container-narrow py-16 lg:py-20">
      <span class="section-tag section-tag--dark">// nos vemos</span>
      <h2 class="section-title-front section-title-front--dark">El 27 nos vemos</h2>
      <p class="section-title-subtitle section-title-subtitle--dark">
        Apúntate con tu correo así te mando la invitación de calendario
        (y calculo tallarines y cartones).
      </p>
      <form id="rsvp-form" class="service-card rsvp-card p-6 lg:p-8 mt-9 text-left" novalidate>
        <span class="service-name">Confirmación</span>

        <div class="form-field mt-4">
          <label class="form-label" for="f-nombre">Tu nombre</label>
          <input class="form-input" id="f-nombre" name="nombre" type="text" required placeholder="¿Quién eres?" autocomplete="name" />
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="form-field !mb-0">
            <label class="form-label" for="f-email">Correo <span class="opt">(te agendo)</span></label>
            <input class="form-input" id="f-email" name="email" type="email" required placeholder="tu@correo.cl" autocomplete="email" />
          </div>
          <div class="form-field !mb-0">
            <label class="form-label" for="f-wsp">WhatsApp <span class="opt">(te recuerdo)</span></label>
            <input class="form-input" id="f-wsp" name="whatsapp" type="tel" required placeholder="+56 9 1234 5678" autocomplete="tel" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 mt-5">
          <div class="form-field !mb-0">
            <span class="form-label" id="lbl-vienes">¿Vienes?</span>
            <div class="form-pills" role="radiogroup" aria-labelledby="lbl-vienes">
              <label class="form-pill"><input type="radio" name="vienes" value="si" required /><span>Sí, voy</span></label>
              <label class="form-pill"><input type="radio" name="vienes" value="quizas" /><span>Tal vez</span></label>
            </div>
          </div>
          <div class="form-field !mb-0">
            <label class="form-label" for="f-amigos">¿Vienes con amigues?</label>
            <select class="form-select" id="f-amigos" name="amigos" required>
              <option value="" selected disabled>Elige</option>
              <option value="0">Solo yo</option>
              <option value="1">+1 amigue</option>
              <option value="2">+2 amigues</option>
              <option value="3">+3 amigues</option>
              <option value="4+">+4 o más</option>
            </select>
          </div>
        </div>

        <div class="form-field mt-5">
          <span class="form-label" id="lbl-rest">¿Alguna restricción alimentaria? <span class="opt">(el menú es vegano)</span></span>
          <div class="form-pills" role="radiogroup" aria-labelledby="lbl-rest">
            <label class="form-pill"><input type="radio" name="tiene_rest" value="no" required /><span>No</span></label>
            <label class="form-pill"><input type="radio" name="tiene_rest" value="si" /><span>Sí</span></label>
          </div>
          <div id="rest-wrap" class="hidden mt-3">
            <label class="sr-only" for="f-restricciones">¿Cuál?</label>
            <input class="form-input" id="f-restricciones" name="restricciones" type="text" placeholder="Cuéntame cuál (celíaca, frutos secos...)" />
          </div>
        </div>

        <div class="form-hp" aria-hidden="true">
          <label>No llenar: <input type="text" name="empresa" tabindex="-1" autocomplete="off" /></label>
        </div>

        <button type="submit" class="btn btn-primary w-full mt-6">Confirmar asistencia</button>
        <p class="form-status" id="rsvp-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <script>
    // Cuenta regresiva al evento: días : hrs : min : seg
    const target = new Date('2026-11-27T20:00:00-03:00').getTime();
    const el = document.getElementById('countdown');
    const set = (k: string, v: string) => {
      const n = el?.querySelector(`[data-cd="${k}"]`);
      if (n) n.textContent = v;
    };
    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      const days = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      set('d', String(days).padStart(2, '0'));
      set('h', String(h).padStart(2, '0'));
      set('m', String(m).padStart(2, '0'));
      set('s', String(s).padStart(2, '0'));
    };
    tick();
    setInterval(tick, 1000);

    // Restricción: el input solo aparece si marca "Sí"
    const restWrap = document.getElementById('rest-wrap');
    const restInput = document.getElementById('f-restricciones') as HTMLInputElement | null;
    document.querySelectorAll('input[name="tiene_rest"]').forEach(radio => {
      radio.addEventListener('change', () => {
        const show = (radio as HTMLInputElement).value === 'si' && (radio as HTMLInputElement).checked;
        restWrap?.classList.toggle('hidden', !show);
        if (!show && restInput) restInput.value = '';
        if (show) restInput?.focus();
      });
    });

    // Apps Script web app: RSVP (POST) + lista de regalos (GET/POST)
    const SCRIPT_ENDPOINT = 'https://script.google.com/macros/s/AKfycbxX4lVRE-27PPU8JIlSqY_IJ2hwOusHjda6GxFCaeIgTw6mXw5Ivjja-SuqcUjqcg1o/exec';
    const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
    const status = document.getElementById('rsvp-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Enviando...';
      }
      try {
        await fetch(SCRIPT_ENDPOINT, {
          method: 'POST',
          mode: 'no-cors',
          body: new FormData(form),
        });
        form.innerHTML = `
          <div class="rsvp-done">
            <p class="firma">¡anotade!</p>
            <p class="text-sm text-custom-dark-gray mt-3">Gracias por confirmar. Te espero el 27 con tallarines y cartones.</p>
          </div>`;
      } catch {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Confirmar asistencia';
        }
        if (status) {
          status.textContent = '// ups, algo falló. Intenta de nuevo.';
          status.classList.add('form-status--err');
        }
      }
    });

    // ── Lista de regalos ──
    // Reserva anónima: el navegador genera un token aleatorio, lo guarda en
    // localStorage y lo manda al Apps Script. El GET devuelve solo la huella
    // (SHA-256 del token) para que cada quien reconozca su regalo sin que
    // nadie más sepa quién lo reservó.
    interface Regalo {
      id: string;
      regalo: string;
      precio: string;
      link: string;
      reservado: boolean;
      huella: string;
    }
    const regalosGrid = document.getElementById('regalos-grid');
    const regalosStatus = document.getElementById('regalos-status');
    const tokenKey = (id: string) => `regalo:${id}`;
    const esc = (s: string) =>
      s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    // Si el precio viene como número crudo desde la Sheet, se muestra con formato CLP
    const fmtPrecio = (p: string) => (/^\d+$/.test(p.trim()) ? `$${Number(p).toLocaleString('es-CL')}` : p);
    const nuevoToken = () =>
      crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}`;

    async function sha256Hex(texto: string) {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(texto));
      return Array.from(new Uint8Array(buf), b => b.toString(16).padStart(2, '0')).join('');
    }

    async function renderRegalos(regalos: Regalo[]) {
      if (!regalosGrid) return;
      // Marca cuáles reservé yo: compara la huella del GET con el token local
      const mios = new Set<string>();
      for (const g of regalos) {
        const token = localStorage.getItem(tokenKey(g.id));
        if (!token) continue;
        if (g.reservado && g.huella && (await sha256Hex(token)) === g.huella) {
          mios.add(g.id);
        } else {
          localStorage.removeItem(tokenKey(g.id));
        }
      }
      if (!regalos.length) {
        regalosGrid.innerHTML = '<tr><td colspan="4"><p class="regalos-msg">// la lista todavía se está cocinando, vuelve pronto</p></td></tr>';
        return;
      }
      regalosGrid.innerHTML = regalos.map(g => {
        const mio = mios.has(g.id);
        const tomado = g.reservado && !mio;
        const estado = mio
          ? `<span class="tag-mono tag-mono--basil">// lo regalas tú</span>
             <button type="button" class="btn btn-tertiary btn-sm" data-action="liberar" data-id="${esc(g.id)}">Liberar</button>`
          : tomado
            ? '<span class="tag-mono">// ya lo regala alguien</span>'
            : `<button type="button" class="btn btn-primary btn-sm" data-action="reservar" data-id="${esc(g.id)}">Yo lo regalo</button>`;
        const link = g.link
          ? `<a href="${esc(g.link)}" target="_blank" rel="noopener noreferrer" class="regalo-link">Ver tienda ↗</a>`
          : '';
        return `
          <tr class="regalo-row${tomado ? ' regalo-row--tomado' : ''}">
            <td class="regalo-nombre">${esc(g.regalo)}</td>
            <td class="regalo-precio">${g.precio ? esc(fmtPrecio(g.precio)) : ''}</td>
            <td>${link}</td>
            <td class="regalo-estado">${estado}</td>
          </tr>`;
      }).join('');
    }

    async function cargarRegalos() {
      if (!regalosGrid) return;
      try {
        const res = await fetch(`${SCRIPT_ENDPOINT}?lista=regalos`);
        const data = await res.json();
        if (!data.ok) throw new Error('respuesta mala');
        await renderRegalos(data.regalos || []);
        if (regalosStatus) regalosStatus.textContent = '';
      } catch {
        regalosGrid.innerHTML = '<tr><td colspan="4"><p class="regalos-msg">// no pude cargar la lista, recarga la página</p></td></tr>';
      }
    }
    cargarRegalos();
    // Refresca al volver a la pestaña por si alguien reservó mientras tanto
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') cargarRegalos();
    });

    regalosGrid?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
      if (!btn) return;
      const id = btn.dataset.id!;
      const action = btn.dataset.action!;
      btn.disabled = true;
      btn.textContent = 'Guardando...';
      const fd = new FormData();
      fd.append('action', action);
      fd.append('id', id);
      let token = localStorage.getItem(tokenKey(id)) || '';
      if (action === 'reservar') {
        token = nuevoToken();
        localStorage.setItem(tokenKey(id), token);
      }
      fd.append('token', token);
      try {
        await fetch(SCRIPT_ENDPOINT, { method: 'POST', mode: 'no-cors', body: fd });
        if (action === 'liberar') localStorage.removeItem(tokenKey(id));
        if (regalosStatus) {
          regalosStatus.classList.remove('form-status--err');
          regalosStatus.textContent = action === 'reservar' ? '// guardando tu reserva...' : '// liberando el regalo...';
        }
        // El POST es no-cors (sin respuesta legible): se confirma releyendo la lista
        setTimeout(cargarRegalos, 900);
      } catch {
        btn.disabled = false;
        btn.textContent = action === 'reservar' ? 'Yo lo regalo' : 'Liberar';
        if (regalosStatus) {
          regalosStatus.textContent = '// ups, algo falló. Intenta de nuevo.';
          regalosStatus.classList.add('form-status--err');
        }
      }
    });
  </script>
</BaseLayout>
